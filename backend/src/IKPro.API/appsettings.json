{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=IKProDb;User Id=sa;Password=Your_strong_Pass123;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "IKPro",
    "Audience": "IKProFrontend",
    "Secret": "ikpro-dev-secret-key-3f6a1c9d2e8b4705a1b2c3d4e5f60718-do-not-use-in-prod",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Email": {
    "_comment": "Mode: 'outbox' (varsayılan, dev/demo — dosyaya yazar) | 'smtp' (üretim). smtp seçilirse aşağıdaki Smtp bloğu (Host+From) zorunludur; şifreyi buraya YAZMAYIN, ortam değişkeninden (Smtp__Password) verin.",
    "Mode": "outbox"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "İK Pro",
    "UseStartTls": true
  },
  "Cleanup": {
    "UnverifiedTenants": {
      "_comment": "Doğrulanmamış (hiç etkinleşmemiş) eski self-servis kiracıların uygulama-içi periyodik silinmesi. Yıkıcı işlem — varsayılan kapalı; üretimde bilinçli açın.",
      "Enabled": false,
      "IntervalHours": 24,
      "OlderThanDays": 30
    }
  },
  "AllowedHosts": "*"
}
