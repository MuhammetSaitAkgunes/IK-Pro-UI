  },
  "Jwt": {
    "Issuer": "IKPro",
    "Audience": "IKProFrontend",
    "Secret": "ikpro-dev-secret-key-3f6a1c9d2e8b4705a1b2c3d4e5f60718-do-not-use-in-prod",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
